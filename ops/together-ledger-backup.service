[Unit]
Description=Together Ledger encrypted database backup and offsite copy
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=TOGETHER_ENV_FILE=/etc/together-ledger/production.env
Environment=BACKUP_RECIPIENT_FILE=/etc/together-ledger/backup-recipient.env
EnvironmentFile=/etc/together-ledger/backup-runtime.env
EnvironmentFile=/etc/together-ledger/backup-uploader.env
ExecStart=/usr/local/lib/together-ledger/run-production-backup.sh
