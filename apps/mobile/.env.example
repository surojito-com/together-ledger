# Copy to .env.local for local development against a locally running API
# server: port 4174 (`PORT` in server/config.js), as the local platform test in
# docs/OPERATIONS.md runs it. Not `npm run dev`, which serves only the static
# web app on 4173 and has no API (#283). Never commit .env.local — it is
# git-ignored already.
#
# Staging and production values are not set here: they are supplied by the
# EAS build profile or CI environment for that build, the same way the web
# client's together-api-origin meta tag is templated per deployment rather
# than hardcoded in index.html.
EXPO_PUBLIC_API_ORIGIN=http://localhost:4174
