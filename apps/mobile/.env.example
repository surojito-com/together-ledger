# Copy to .env.local for local development against a locally running API
# server: port 4174 (`PORT` in server/config.js), as the local platform test in
# docs/OPERATIONS.md runs it. Not `npm run dev`, which serves only the static
# web app on 4173 and has no API (#283). Never commit .env.local — it is
# git-ignored already.
#
# Staging and production values are not set here: they are supplied by the
# EAS build profile or CI environment for that build, the same way the web
# client's together-api-origin meta tag is templated per deployment rather
# than hardcoded in index.html.
EXPO_PUBLIC_API_ORIGIN=http://localhost:4174

# Continue with Google (#217). Public client IDs, never secrets, and never written into the source:
# a development build reads them from here, and EAS builds from the profile's env in eas.json.
# Unset, the phone offers no Google, and on an iPhone no Apple either (src/config/google.ts).
# The iOS client also becomes the URL scheme Google returns to (app.config.js), so change it only
# before a prebuild. Android asks Google for a token issued to the web client: the same value as the
# server's GOOGLE_WEB_CLIENT_ID.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<iOS client>.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<web client>.apps.googleusercontent.com
