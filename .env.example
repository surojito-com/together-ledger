NODE_ENV=development
HOST=0.0.0.0
PORT=4174
PUBLIC_ORIGIN=http://127.0.0.1:4174
# Comma-separated exact additional frontend origins for a temporary dual-host rollout.
APP_ORIGINS=
DATABASE_URL=postgres://together:change-me@postgres:5432/together_ledger
DATABASE_SSL=false
SESSION_SECRET=generate-a-random-value-of-at-least-32-characters
AUDIT_HMAC_KEY=generate-a-different-random-value-of-at-least-32-characters
COOKIE_SECURE=false
TRUST_PROXY=false
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=Together Ledger <no-reply@together.local>

# The public/default service stays two-person. Use test-groups only in a
# non-production staging environment for synthetic 3–99 person verification.
JOURNEY_CAPACITY_MODE=two-person

# Stripe web billing stays off until test-mode Products, Prices, and a webhook
# endpoint have been configured. Never commit completed values.
BILLING_ENABLED=false
BILLING_PORTAL_ENABLED=false
STRIPE_ENVIRONMENT=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ADDITIONAL_PERSON_PRICE_ID=
MOMENT_IMAGE_BILLING_ENABLED=false
STRIPE_ADDITIONAL_IMAGE_PRICE_ID=
MOMENT_LOCATION_BILLING_ENABLED=false
STRIPE_ADDITIONAL_LOCATION_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_TAX_ENABLED=false
BILLING_GRACE_DAYS=7

# App Store and Google Play purchases, checked on this server (#272,
# docs/STORE_PURCHASES.md). Each store stays off, and its purchases are answered
# "can't be checked right now", until its trust is set. STORE_ENVIRONMENT says
# which purchases count here: live (real money) or sandbox (test purchases),
# never both. APPLE_ROOT_CERTIFICATES is Apple Root CA - G3, base64 DER, downloaded
# from apple.com/certificateauthority and its fingerprint checked. The Play
# service account's key JSON comes from Secrets Manager, on one line or base64.
STORE_ENVIRONMENT=sandbox
APPLE_ROOT_CERTIFICATES=
APPLE_BUNDLE_ID=com.togetherledger.ledger
GOOGLE_PLAY_PACKAGE_NAME=com.togetherledger.ledger
GOOGLE_PLAY_SERVICE_ACCOUNT=
