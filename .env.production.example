# Copy to a root-owned file outside the repository, for example:
# /etc/together-ledger/production.env (mode 0600)
# Do not commit the completed file or send its values in chat.
TOGETHER_IMAGE=registry.example/together-ledger@sha256:replace-with-reviewed-digest
CADDY_DOMAIN=api.together-ledger.com
CADDY_EMAIL=hostmaster@together-ledger.com

NODE_ENV=production
PUBLIC_ORIGIN=https://app.together-ledger.com
# During the dual-host rollout, keep the current root app accepted while the
# same running app is also available at app.together-ledger.com.
APP_ORIGINS=https://together-ledger.com
API_ORIGIN=https://api.together-ledger.com
# Safe fallback for trusted non-browser jobs. Browser-issued verification,
# recovery, and invitation emails preserve the already allowlisted origin that
# requested them, whether that is the public home or the direct API client.
ACCOUNT_ORIGIN=https://app.together-ledger.com
DATABASE_SSL=false
COOKIE_SECURE=true
TRUST_PROXY=true
POSTGRES_DB=together_ledger
POSTGRES_USER=together
# Generate this as URL-safe lower-case hex, for example: openssl rand -hex 32.
# The deployment bundle safely derives DATABASE_URL from this value.
POSTGRES_PASSWORD=replace-with-64-hex-characters
SESSION_SECRET=replace-with-a-different-long-random-secret
AUDIT_HMAC_KEY=replace-with-a-different-long-random-secret
SMTP_URL=smtps://resend:replace-with-resend-api-key@smtp.resend.com:465
# The three purpose-specific sender addresses appear in a recipient's inbox.
# They must use a domain verified with the configured email delivery provider.
MAIL_FROM_INVITATION=Together Ledger - 010 Journey Invite <journey-invitation@together-ledger.com>
MAIL_FROM_VERIFICATION=Together Ledger - 020 Email Verification <account-verification@together-ledger.com>
MAIL_FROM_RECOVERY=Together Ledger - 030 Password Reset <account-recovery@together-ledger.com>
# Legacy fallback for a deployment that has not yet configured every sender.
MAIL_FROM=Together Ledger <no-reply@together-ledger.com>
JOURNEY_CAPACITY_MODE=two-person

# Sign in with Google and Apple (#214, #218). The client IDs, Team ID, key ID
# and Return URL are public and default correctly; set GOOGLE_CLIENT_IDS once
# Together Ledger's own Google OAuth clients exist. The two Apple secrets come
# from Secrets Manager (docs/SERVER_DEPLOY.md, step 2): the Sign in with Apple
# key 985BDXJP8S's .p8 contents on one line, and 32 random bytes in base64 that
# encrypt Apple's refresh tokens. Until both are set, no Apple account opens.
# GOOGLE_WEB_CLIENT_ID is the web's own Google client (#216); it is accepted
# without being repeated in GOOGLE_CLIENT_IDS. The web shows "Continue with
# Google" and "Continue with Apple" only once it and both Apple secrets are set.
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
APPLE_TOKEN_ENCRYPTION_KEY=

# Keep billing disabled through deployment rehearsals. Set these only in the
# root-owned environment file after a separate test-mode acceptance pass.
BILLING_ENABLED=false
BILLING_PORTAL_ENABLED=false
STRIPE_ENVIRONMENT=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ADDITIONAL_PERSON_PRICE_ID=
MOMENT_IMAGE_BILLING_ENABLED=false
STRIPE_ADDITIONAL_IMAGE_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_TAX_ENABLED=false
BILLING_GRACE_DAYS=7

# App Store and Google Play purchases, checked on this server (#272,
# docs/STORE_PURCHASES.md). Each store stays off, and its purchases are answered
# "can't be checked right now", until its trust is set. STORE_ENVIRONMENT says
# which purchases count here: live (real money) or sandbox (test purchases),
# never both. APPLE_ROOT_CERTIFICATES is Apple Root CA - G3, base64 DER, downloaded
# from apple.com/certificateauthority and its fingerprint checked. The Play
# service account's key JSON comes from Secrets Manager, on one line or base64.
STORE_ENVIRONMENT=sandbox
# Live servers only: account ids, comma-separated, whose sandbox purchases still
# count (App Review's sample account, the owner's test accounts). The review
# account gets a new id each time server/seed-review-journey.js rebuilds it.
STORE_SANDBOX_ACCOUNT_IDS=
APPLE_ROOT_CERTIFICATES=
APPLE_BUNDLE_ID=com.togetherledger.ledger
GOOGLE_PLAY_PACKAGE_NAME=com.togetherledger.ledger
GOOGLE_PLAY_SERVICE_ACCOUNT=
# Google Play's Real-time developer notifications (#273), pushed by Pub/Sub to
# /api/v1/billing/store-notifications/google. Either one empty: every push is refused.
# The audience set on the push subscription, and the email of the service account
# it authenticates as (docs/STORE_PURCHASES.md, "Google: Real-time developer notifications").
GOOGLE_PLAY_NOTIFICATIONS_AUDIENCE=
GOOGLE_PLAY_NOTIFICATIONS_SERVICE_ACCOUNT_EMAIL=
# This many store refunds or revocations within this many hours writes one error
# line, "store refunds spiking" (docs/STORE_PURCHASES.md, "When refunds spike").
STORE_REFUND_ALERT_THRESHOLD=5
STORE_REFUND_ALERT_WINDOW_HOURS=24
