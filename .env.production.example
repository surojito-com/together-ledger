# Copy to a root-owned file outside the repository, for example:
# /run/together-ledger/production.env (mode 0600)
# Do not commit the completed file or send its values in chat.
TOGETHER_IMAGE=registry.example/together-ledger@sha256:replace-with-reviewed-digest
CADDY_DOMAIN=api.together.surojito.com
CADDY_EMAIL=cloud-owner@surojito.com

NODE_ENV=production
PUBLIC_ORIGIN=https://together.surojito.com
DATABASE_SSL=false
COOKIE_SECURE=true
TRUST_PROXY=true
POSTGRES_DB=together_ledger
POSTGRES_USER=together
# Generate this as URL-safe lower-case hex, for example: openssl rand -hex 32.
# The deployment bundle safely derives DATABASE_URL from this value.
POSTGRES_PASSWORD=replace-with-64-hex-characters
SESSION_SECRET=replace-with-a-different-long-random-secret
AUDIT_HMAC_KEY=replace-with-a-different-long-random-secret
SMTP_URL=smtp://replace-with-ses-smtp-user:replace-with-ses-smtp-password@email-smtp.region.amazonaws.com:587
MAIL_FROM=Together Ledger <no-reply@together.surojito.com>
